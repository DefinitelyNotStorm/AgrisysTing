<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="dk.agrisysting.agrisysting.controller.AnalysisController"
            prefWidth="700"
            prefHeight="500">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>

            <Label text="Analyse"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;" />

            <Label text="Her vises simple nøgletal ud fra grisedata i databasen." />
        </VBox>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER_LEFT">
            <padding>
                <Insets top="20" right="40" bottom="20" left="40"/>
            </padding>

            <Label fx:id="totalAnimalsLabel"
                   text="Antal grise i alt:"
                   style="-fx-font-size: 18px;" />

            <Label fx:id="activeAnimalsLabel"
                   text="Aktive grise:"
                   style="-fx-font-size: 18px;" />

            <Label fx:id="inactiveAnimalsLabel"
                   text="Inaktive grise:"
                   style="-fx-font-size: 18px;" />

            <Separator />

            <Label fx:id="averageFcrLabel"
                   text="Gennemsnitlig FCR:"
                   style="-fx-font-size: 18px;" />

            <Label fx:id="averageStartWeightLabel"
                   text="Gennemsnitlig startvægt:"
                   style="-fx-font-size: 18px;" />

            <Label fx:id="averageEndWeightLabel"
                   text="Gennemsnitlig slutvægt:"
                   style="-fx-font-size: 18px;" />

        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="20" bottom="20" left="20"/>
            </padding>

            <Button text="Tilbage til hovedmenu"
                    onAction="#handleBackToDashboard" />

            <Button text="Opdater analyse"
                    onAction="#loadAnalysis" />

            <Label fx:id="messageLabel"
                   text=""
                   style="-fx-text-fill: green;" />
        </HBox>
    </bottom>

</BorderPane>


<!--
FXML bruges til at bygge brugerfladen i JavaFX
Her beskriver jeg hvordan knapper labels tabeller osv skal se ud og placeres

fx:controller kobler FXML filen sammen med dens controller klasse i Java

VBox = Lægger elementer lodret under hinanden
HBox = Lægger elementer vandret ved siden af hinanden
BorderPane = Deler siden op i top center bund højre og venstre

padding = Luft rundt om elementerne
spacing = Afstand mellem elementer inde i VBox eller HBox
alignment = Bestemmer hvordan elementerne placeres

Label = Viser tekst i brugerfladen
Button = Knap brugeren kan trykke på
TextField = Tekstfelt brugeren kan skrive i
PasswordField = Tekstfelt hvor teksten skjules
TableView = Tabel som viser data fra databasen
TableColumn = En kolonne inde i tabellen
Separator = En streg som deler indhold op

fx:id bruges til at forbinde et element med Java koden i controlleren
onAction bruges når en knap skal kalde en metode i controlleren

prefWidth og prefHeight bestemmer standard størrelse på elementer eller vinduer
style bruges til hurtig styling direkte i FXML filen

XML er bygget op med tags
Et åbne tag starter et element
Et lukke tag afslutter elementet

Eksempel
<VBox>
    <Label text="Hej"/>
</VBox>

Det betyder at Label ligger inde i VBoxen
-->